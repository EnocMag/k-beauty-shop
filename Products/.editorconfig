root = true

# ============================================================
# General
# ============================================================

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

indent_style = space
indent_size = 4
tab_width = 4

# ============================================================
# C#
# ============================================================

[*.cs]

# ------------------------------------------------------------
# Usings
# ------------------------------------------------------------

dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
dotnet_diagnostic.IDE0055.severity = error

csharp_using_directive_placement = outside_namespace

# ------------------------------------------------------------
# Naming
# ------------------------------------------------------------

dotnet_naming_rule.interface_should_be_pascal_case.severity = error
dotnet_naming_rule.interface_should_be_pascal_case.symbols = interface
dotnet_naming_rule.interface_should_be_pascal_case.style = pascal_case

dotnet_naming_symbols.interface.applicable_kinds = interface
dotnet_naming_symbols.interface.applicable_accessibilities = *

dotnet_naming_style.pascal_case.capitalization = pascal_case

# Classes, methods, properties, etc.
dotnet_naming_rule.types_should_be_pascal_case.severity = error
dotnet_naming_rule.types_should_be_pascal_case.symbols = types
dotnet_naming_rule.types_should_be_pascal_case.style = pascal_case

dotnet_naming_symbols.types.applicable_kinds = class, struct, enum, delegate
dotnet_naming_symbols.types.applicable_accessibilities = *

# Private fields: _camelCase
dotnet_naming_rule.private_fields_should_be_camel_case.severity = error
dotnet_naming_rule.private_fields_should_be_camel_case.symbols = private_fields
dotnet_naming_rule.private_fields_should_be_camel_case.style = private_field_style

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private, internal
dotnet_naming_symbols.private_fields.required_modifiers = 

dotnet_naming_style.private_field_style.capitalization = camel_case
dotnet_naming_style.private_field_style.required_prefix = _

# ------------------------------------------------------------
# New lines
# ------------------------------------------------------------

csharp_new_line_before_open_brace = all

csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true

# ------------------------------------------------------------
# Namespaces
# ------------------------------------------------------------

csharp_style_namespace_declarations = file_scoped:error

# ------------------------------------------------------------
# Spacing
# ------------------------------------------------------------

csharp_space_after_comma = true
csharp_space_before_comma = false

csharp_space_after_keywords_in_control_flow_statements = true

csharp_space_before_open_square_brackets = false
csharp_space_before_open_parenthesis = false

csharp_space_between_method_declaration_parameter_list_parentheses = false
csharp_space_between_method_call_parameter_list_parentheses = false

# ------------------------------------------------------------
# var
# ------------------------------------------------------------

csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# ------------------------------------------------------------
# Expressions
# ------------------------------------------------------------

dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = true:suggestion
dotnet_style_coalesce_expression = true:suggestion
dotnet_style_null_propagation = true:suggestion

# ------------------------------------------------------------
# Modern C#
# ------------------------------------------------------------

csharp_style_prefer_switch_expression = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion

# ------------------------------------------------------------
# readonly
# ------------------------------------------------------------

dotnet_style_readonly_field = true:suggestion

# ------------------------------------------------------------
# Expression-bodied members
# ------------------------------------------------------------

csharp_style_expression_bodied_methods = false:suggestion
csharp_style_expression_bodied_constructors = false:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_indexers = true:suggestion

# ============================================================
# JSON
# ============================================================

[*.json]
indent_style = space
indent_size = 2

# ============================================================
# YAML
# ============================================================

[*.{yml,yaml}]
indent_style = space
indent_size = 2

# ============================================================
# XML
# ============================================================

[*.xml]
indent_style = space
indent_size = 2
